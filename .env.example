# ---------------------------------------------------------------------------
# NEXUS STORE — ENVIRONMENT VARIABLES
# ---------------------------------------------------------------------------
# The store runs FULLY in demo mode with zero keys: sample products, a cart
# saved in your browser, and a simulated checkout. Add the keys below to
# .env.local (copy this file) to switch on real Supabase + Stripe features.
#
#   cp .env.example .env.local

# ---- Supabase (auth, database, storage) -----------------------------------
# Project Settings → API → Project URL / anon public key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS. Used by the webhook to save orders and by API
# routes to read the catalog. NEVER prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Stripe (payments) ----------------------------------------------------
# Stripe Dashboard → Developers → API keys (pk_test_… / sk_test_…)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Stripe Dashboard → Developers → Webhooks (whsec_…), or the `stripe listen`
# CLI output while testing locally.
STRIPE_WEBHOOK_SECRET=

# ---- Resend (transactional email: receipts + download links) --------------
# app.resend.com → API Keys
RESEND_API_KEY=

# ---- Admin ----------------------------------------------------------------
# Demo admin PIN (client-side only; default admin123). Replace with real
# Supabase email auth for production.
NEXT_PUBLIC_ADMIN_PIN=admin123